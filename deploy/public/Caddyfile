{
    email {$ACME_EMAIL}
    admin off
}

{$PUBLIC_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
    @auth path /api/auth/* /api/admin/* /api/account
    request_body @auth {
        max_size 16KB
    }
    request_body {
        max_size 528MB
    }
    handle /api/* {
        reverse_proxy api:8000 {
            flush_interval -1
            transport http {
                read_timeout 10m
            }
        }
    }
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}
