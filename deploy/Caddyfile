{
	admin off
	servers {
		max_header_size 64KB
	}
}

{$P2H_SITE_ADDRESS} {
	encode zstd gzip

	route {
		basic_auth {
			{$P2H_ADMIN_USER} {$P2H_ADMIN_PASSWORD_HASH}
		}

		request_body {
			max_size {$P2H_MAX_REQUEST_BODY_BYTES}
		}

		handle /api/* {
			reverse_proxy 127.0.0.1:8000 {
				header_up X-P2H-Proxy-Secret {$P2H_TRUSTED_PROXY_SECRET}
				header_down -Server
			}
		}

		handle {
			root * {$P2H_FRONTEND_ROOT}
			try_files {path} /index.html
			file_server
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age={$P2H_HSTS_MAX_AGE_SECONDS}; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	@frontend not path /api/*
	header @frontend {
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Cross-Origin-Resource-Policy "same-origin"
	}

	log {
		output file {$P2H_ACCESS_LOG} {
			mode 0600
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
