# Template rendered by ./install.sh --systemd. Placeholders such as @ROOT_DIR@
# are replaced with this checkout, the installing user and its configuration.
[Unit]
Description=Problem Change Center frontend (static Web UI)
Documentation=file:@ROOT_DIR@/deploy/README.md
After=network-online.target oj-package-converter.service
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@ROOT_DIR@
Environment=P2H_FRONTEND_HOST=127.0.0.1
EnvironmentFile=@ENV_FILE@
Environment=NODE_ENV=production
ExecStart=@NODE_BIN@ @ROOT_DIR@/scripts/serve-frontend.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
