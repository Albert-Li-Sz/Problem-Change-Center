# Copy to /etc/oj-package-converter/production.env, replace every CHANGE_ME
# value, then chmod 600. Values use systemd EnvironmentFile syntax, not shell.

P2H_DEPLOYMENT_MODE=production
P2H_DATA_DIR=/var/lib/oj-package-converter
P2H_RUNNER_IMAGE=p2h-runner
P2H_DOCKER_BIN=docker
DOCKER_HOST=unix:///run/user/1001/docker.sock
P2H_REQUIRE_ROOTLESS_DOCKER=1

P2H_ALLOWED_HOSTS=convert.example.com
P2H_ALLOWED_ORIGINS=https://convert.example.com
P2H_TRUSTED_PROXY_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

P2H_MAX_UPLOAD_BYTES=536870912
P2H_MAX_REQUEST_BODY_BYTES=553648128
P2H_RATE_LIMIT_REQUESTS_PER_MINUTE=240
P2H_RATE_LIMIT_UPLOADS_PER_MINUTE=12
P2H_HSTS_MAX_AGE_SECONDS=31536000
P2H_READINESS_TIMEOUT_SECONDS=5

P2H_JOB_TIMEOUT_SECONDS=7200
P2H_JOB_IDLE_TIMEOUT_SECONDS=300
P2H_JOB_STAGE_TIMEOUT_SECONDS=1800
P2H_JOB_PROBLEM_TIMEOUT_SECONDS=1200
P2H_JOB_TTL_SECONDS=86400
P2H_MAX_CONCURRENT_JOBS=2
P2H_MAX_STORED_JOBS=100
P2H_MAX_STORAGE_BYTES=10737418240
P2H_MAX_LOG_BYTES=10485760
P2H_DOCKER_MEMORY=1g
P2H_DOCKER_CPUS=2
P2H_DOCKER_PIDS_LIMIT=1024
P2H_DOCKER_WINE_PIDS_LIMIT=4096
P2H_DOCKER_WINE_HOME_SIZE=4g
P2H_DOCKER_TMP_SIZE=512m
P2H_DOCKER_WORK_SIZE=1g
P2H_DOCKER_OUTPUT_SIZE=1g

# Caddy reads these values from the same EnvironmentFile.
P2H_SITE_ADDRESS=convert.example.com
P2H_FRONTEND_ROOT=/opt/oj-package-converter/frontend/dist
P2H_ADMIN_USER=admin
P2H_ADMIN_PASSWORD_HASH=CHANGE_ME_GENERATE_WITH_CADDY_HASH_PASSWORD
P2H_ACCESS_LOG=/var/log/oj-package-converter/access.json
